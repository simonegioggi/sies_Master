<?xml version="1.0" encoding="UTF-8"?>
<definitions targetNamespace="http://it/mig/sies/type" xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:conv="http://www.openuri.org/2002/04/wsdl/conversation/" xmlns:http="http://schemas.xmlsoap.org/wsdl/http/" xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:soap12enc="http://www.w3.org/2003/05/soap-encoding" xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns:tns="http://it/mig/sies/type" xmlns:wsr="http://www.openuri.org/2002/10/soap/reliability/">
 <types>
  <xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://it/mig/sies/type" xmlns="http://it/mig/sies/type" xmlns:xs="http://www.w3.org/2001/XMLSchema">
   <xs:element name="ANAGRAFICA">
    <xs:annotation>
     <xs:appinfo>E' l'elemento che contiene i dati relativi al Soggetto.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element ref="DATI_ANAGRAFICI">
       <xs:annotation>
        <xs:appinfo>E' l'elemento che contiene i dati anagrafici del Soggetto.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element ref="PROCEDIMENTO">
       <xs:annotation>
        <xs:appinfo>E’ l’elemento che contiene tutte le informazioni relative alla sentenza.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" ref="CERTIFICATO">
       <xs:annotation>
        <xs:appinfo>E' l'elemento che contiene il certificato del Soggetto.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayBenefici">
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" ref="BENEFICIO">
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayCassazione">
    <xs:annotation>
     <xs:appinfo>E' l'elemento contenitore di una lista di sentenze di cassazione.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="CASSAZIONE">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore di sentenze di Cassazione.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayCircostanze">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di Circostanze.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="CIRCOSTANZA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di una circostanza.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayImpugnazioni">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di impugnazioni.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="IMPUGNAZIONE">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di un'impugnazione.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayMisureSicurezza">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di misure di sicurezza.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="MISURA_DI_SICUREZZA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di una Misura di Sicurezza.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayOmonimi">
    <xs:annotation>
     <xs:appinfo>Rappresenta una lista di elementi omonimi.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="OMONIMO">
       <xs:annotation>
        <xs:appinfo>E' l'elemento contenitore di un soggetto omonimo.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayPenaComplessiva">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di reati di pena complessiva.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="DISPOSITIVO_PENA_COMPLESSIVA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di una dispositivo di Pena Complessiva.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayPeneAccessorie">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di pene accessorie.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="PENA_ACCESSORIA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di una Pena Accessoria.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayPeneAggiunte">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di pene aggiunte.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="PENA_AGGIUNTA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di un provvedimento di Pena Aggiunta.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayPrimoGrado">
    <xs:annotation>
     <xs:appinfo>E' l'elemento contenitore di una lista di sentenze di primo grado.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="PRIMO_GRADO">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore di una sentenza di Primo Grado</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayProgressiviReati">
    <xs:annotation>
     <xs:appinfo>E' l'elemento contenitore di una lista di progressivi dei reati.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="Numero">
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayReati">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di reati.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="REATO">
       <xs:annotation>
        <xs:documentation>
        </xs:documentation>
        <xs:documentation>Elemento contenitore dei dati del reato.</xs:documentation>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArrayRevoche">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore di una lista di revoche.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="REVOCA">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dei dati di un provvedimento di revoca.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="ArraySecondoGrado">
    <xs:annotation>
     <xs:appinfo>E' l'elemento contenitore di una lista di sentenze di secondo grado.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element maxOccurs="unbounded" minOccurs="0" ref="SECONDO_GRADO">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore di una sentenza di Secondo Grado.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="BENEFICIO">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore dei dati di un beneficio diverso dal condono e dalla sostituzione pena.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element name="PROG_BENEFICIO">
       <xs:annotation>
        <xs:appinfo>Identificativo del beneficio.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element name="CODI_TIPO_BENEFICIO">
       <xs:annotation>
        <xs:appinfo>Codice del tipo beneficio.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="3">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DURATA_RECLUSIONE" type="DURATA">
       <xs:annotation>
        <xs:appinfo>Anni, mesi e giorni di reclusione beneficiati.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DURATA_ARRESTO" type="DURATA">
       <xs:annotation>
        <xs:appinfo>Anni, mesi e giorni di arresto beneficiati.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="IMPO_MULTA">
       <xs:annotation>
        <xs:appinfo>Importo della multa del beneficio.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:decimal">
         <xs:totalDigits value="14">
         </xs:totalDigits>
         <xs:fractionDigits value="2">
         </xs:fractionDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="IMPO_AMMENDA" type="xs:decimal">
       <xs:annotation>
        <xs:appinfo>Importo dell'ammenda del beneficio.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DURATA_LIBERTA_CONTROLLATA" type="DURATA">
       <xs:annotation>
        <xs:appinfo>Anni, mesi e giorni di libertà controllata beneficiati.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DURATA_SEMIDETENZIONE" type="DURATA">
       <xs:annotation>
        <xs:appinfo>Anni, mesi e giorni di semidetenzione beneficiati.</xs:appinfo>
       </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="DURATA_PERMANENZA_DOMICILIARE" type="DURATA">
       <xs:annotation>
        <xs:appinfo>Anni, mesi e giorni di permanenza domiciliare beneficiati.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="CASSAZIONE">
    <xs:annotation>
     <xs:appinfo>E' l'elemento contenitore delle sentenze della cassazione.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element ref="IMPUGNAZIONE">
       <xs:annotation>
        <xs:appinfo>Elemento contenitore dell'impugnazione.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="CERTIFICATO" type="xs:base64Binary">
    <xs:annotation>
     <xs:appinfo>E' il certificato del Soggetto iscritto nel casellario giudiziale.</xs:appinfo>
    </xs:annotation>
   </xs:element>
   <xs:element name="CHIAVI">
    <xs:annotation>
     <xs:appinfo>Rappresenta il tipo 'contenitore' degli identificativi, del soggetto e del provvedimento, sul sistema NSC e SIES.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element minOccurs="0" name="K_A_NSC">
       <xs:annotation>
        <xs:appinfo>Rappresenta l'identificativo del soggetto sul sistema NSC.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="K_A_SIES">
       <xs:annotation>
        <xs:appinfo>Rappresenta l'identificativo del soggetto sul sistema SIES.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="K_P_NSC">
       <xs:annotation>
        <xs:appinfo>Rappresenta l'identificativo del provvedimento sul sistema NSC.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="K_P_SIES">
       <xs:annotation>
        <xs:appinfo>Rappresenta l'identificativo del provvedimento sul sistema SIES.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="CIRCOSTANZA">
    <xs:annotation>
     <xs:appinfo>E' l'elmento contenitore dei dati della circostanza.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element name="PROG_CIRCOSTANZE">
       <xs:annotation>
        <xs:appinfo>Identificativo della circostanza.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="CODI_TL">
       <xs:annotation>
        <xs:appinfo>Codice del testo legislativo.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="3">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ANNO_LS">
       <xs:annotation>
        <xs:appinfo>Anno della legge speciale.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="4">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="NUME_LS">
       <xs:annotation>
        <xs:appinfo>Numero della legge speciale.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="4">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_LS">
       <xs:annotation>
        <xs:appinfo>Articolo della Legge Speciale.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="4">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_BTQ">
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="2">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_COMMA">
       <xs:annotation>
        <xs:appinfo>Comma della circostanza.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="3">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_COMMA_BTQ">
       <xs:annotation>
        <xs:appinfo>bis, ter.. del comma.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="2">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_LETTERA">
       <xs:annotation>
        <xs:appinfo>Lettera della circostanza.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="2">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_LETTERA_BTQ">
       <xs:annotation>
        <xs:appinfo>bis, ter.. della lettera.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="3">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_NUME_ARTICOLO">
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="2">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ARTI_NUME_ARTICOLO_BTQ">
       <xs:annotation>
        <xs:appinfo>bis, ter.. del numero.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="2">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="FLAG_RELAZ_SOST_MODIF_RSM">
       <xs:annotation>
        <xs:appinfo>Indica se la circostanza è in relazione, sostituito o modificato rispetto all’articolo.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="1">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="FLAG_CIRC_GENERICHE">
       <xs:annotation>
        <xs:appinfo>Flag per estrarre nella stampa la descrizione senza indicare l’articolo,comma etc</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="1">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DESC_CONC_CIRC">
       <xs:annotation>
        <xs:appinfo>Descrizione del concorso in circostanze concorrenti.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="40">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DESC_IPOTESI_REATO">
       <xs:annotation>
        <xs:appinfo>Descrizione dell'ipotesi di reato.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="500">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DESC_REATO">
       <xs:annotation>
        <xs:appinfo>Descrizione completo del reato.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="70">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DESC_QTA_FLAG_IPO_REATO">
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="15">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="NUME_QTA_FLAG_IPO_REATO">
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="2">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="DATA_DECR_MINIS" type="DATA">
       <xs:annotation>
        <xs:appinfo>Data del decreto ministeriale.</xs:appinfo>
       </xs:annotation>
      </xs:element>
     </xs:sequence>
    </xs:complexType>
   </xs:element>
   <xs:element name="CONDONO">
    <xs:annotation>
     <xs:appinfo>E' l'elementocontenitore dei dati del beneficio di condono.</xs:appinfo>
    </xs:annotation>
    <xs:complexType>
     <xs:sequence>
      <xs:element name="PROG_BENEFICIO">
       <xs:annotation>
        <xs:appinfo>Identificativo del beneficio.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:integer">
         <xs:totalDigits value="15">
         </xs:totalDigits>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element name="CODI_TIPO_BENEFICIO">
       <xs:annotation>
        <xs:appinfo>Codice tipo beneficio.</xs:appinfo>
       </xs:annotation>
       <xs:simpleType>
        <xs:restriction base="xs:string">
         <xs:maxLength value="3">
         </xs:maxLength>
        </xs:restriction>
       </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="CODI_TL">
       <xs:annotation>
