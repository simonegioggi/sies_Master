					<xs:annotation>
						<xs:documentation>cf avvocato</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="codTipoUfficio" type="xs:string">
					<xs:annotation>
						<xs:documentation>UDS: Ufficio di Sorveglianza
							TDS: Tribunale di
							Sorveglianza
							UDSM:Ufficio di Sorveglianza Minori
							TDSM:Tribunale di
							Sorveglianza Minori
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="codDistretto" type="xs:string">
					<xs:annotation>
						<xs:documentation>codice distretto</xs:documentation>
					</xs:annotation>
				</xs:element>
				<!-- MEV_20: aggiunto campo -->
				<xs:element name="codUfficioDistretto" type="xs:string">
					<xs:annotation>
						<xs:documentation>codice ufficio distretto</xs:documentation>
					</xs:annotation>
				</xs:element>
				<!-- MEV_20: FINE -->
				<xs:element name="idSoggetto" type="xs:integer">
					<xs:annotation>
						<xs:documentation>identificativo soggetto</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ELENCO_PROCEDIMENTI_OUTPUT">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="elencoProcedimenti" type="type:DATI_PROCEDIMENTO_TYPE" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>elenco dei procedimenti</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="type:ERRORE">
					<xs:annotation>
						<xs:documentation>contenitore di errori</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
