					<xs:documentation>codice tipo atto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="descrTipoAtto" type="xs:string" nillable="true">
				<xs:annotation>
					<xs:documentation>descrizione tipo atto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="codTipoUfficio" type="xs:string">
				<xs:annotation>
					<xs:documentation>UDS: Ufficio di Sorveglianza						TDS: Tribunale diSorveglianza						UDSM:Ufficio di Sorveglianza Minori					TDSM:Tribunale diSorveglianza Minori	</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- MEV_20: aggiunti tre campi -->
			<xs:element name="descrTipoUfficio" type="xs:string" nillable="true">
				<xs:annotation>
					<xs:documentation>descrizione tipo ufficio</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="codUfficioDistretto" type="xs:string">
				<xs:annotation>
					<xs:documentation>codice ufficio distretto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="descrUfficioDistretto" type="xs:string" nillable="true">
				<xs:annotation>
					<xs:documentation>descrizione ufficio distretto</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- MEV_20: FINE -->
		</xs:sequence>
