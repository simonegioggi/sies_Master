			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="type:DATI_SOGGETTO_INPUT">
					<xs:annotation>
						<xs:documentation>elemento contentitore dei dati di input per la ricerca dell'elenco dei procedimenti</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="type:ELENCO_PROCEDIMENTI_OUTPUT">
					<xs:annotation>
						<xs:documentation>elemento contentitore dei dati di outup della ricerca dell'elenco dei procedimenti</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
