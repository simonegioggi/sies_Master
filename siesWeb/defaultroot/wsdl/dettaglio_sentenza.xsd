<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:type="http://it/eng/giustizia/avvocatura/ws/type/dettaglioSentenza" targetNamespace="http://it/eng/giustizia/avvocatura/ws/type/dettaglioSentenza" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DETTAGLIO_SENTENZA">
		<xs:annotation>
			<xs:documentation>Comment describing your root element
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="type:DATI_INPUT_DETTAGLIO"/>
				<xs:element ref="type:OUTPUT_DETTAGLIO_SENTENZA"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ERRORE">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CODICE_ERRORE" type="xs:string"/>
				<xs:element name="DESCR_ERRORE" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DATI_INPUT_DETTAGLIO">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="idEvento" type="xs:string"/>
				<xs:element name="codiTipoProvvedimento" type="xs:string"/>
				<xs:element name="codiceEsito" type="xs:string"/>
				<xs:element ref="type:DATI_AVVISO">
					<xs:annotation>
						<xs:documentation>elemento da valorizzare per richiesta di
							dettaglio da elenco Avvisi. Serve per l'aggiornamento del
							flagVisualizzazione
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="DATA_TYPE">
		<xs:sequence>
			<xs:element name="giorno" type="xs:int"/>
			<xs:element name="mese" type="xs:int"/>
			<xs:element name="anno" type="xs:int"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="DATI_SENTENZA">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="tipoSentenza" type="xs:string"/>
				<xs:element name="dataEmissioneSentenza" type="type:DATA_TYPE"/>
				<xs:element name="annoSentenza" type="xs:integer"/>
				<xs:element name="numeroSentenza" type="xs:string"/>
				<xs:element name="dataDepositoCancelleria" type="type:DATA_TYPE"/>
				<xs:element name="statoProvvedimento" type="xs:string"/>
				<xs:element name="descrizioneDecisione" type="xs:string"/>
				<xs:element name="dispositivo" type="xs:string"/>
				<xs:element name="motivazioni" type="xs:string"/>
				<xs:element name="elencoEsiti" type="type:ESITI_TYPE" maxOccurs="unbounded"/>
				<xs:element name="elencoDestinatari" type="type:DESTINATARI_TYPE" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ESITI_TYPE">
		<xs:sequence>
			<xs:element name="descrOggettoTenore" type="xs:string"/>
			<xs:element name="descrEsitoTenore" type="xs:string"/>
			<xs:element name="oggettoProcedimento" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DESTINATARI_TYPE">
		<xs:sequence>
			<xs:element name="descrUffiicio" type="xs:string"/>
			<xs:element name="descrAutorita" type="xs:string"/>
			<xs:element name="descrSedeAutorita" type="xs:string"/>
			<xs:element name="descrTipoIstitutoDetenzione" type="xs:string"/>
			<xs:element name="descrComuneIstitutoDetenzione" type="xs:string"/>
			<xs:element name="avvocato_fasc_SIEP" type="xs:string"/>
			<xs:element name="avvocato_fasc_SIUS" type="xs:string"/>
			<xs:element name="indirizzo_UEPE" type="xs:string"/>
			<xs:element name="comune_UEPE" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="DATI_AVVISO" nillable="true">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="idAvviso" type="xs:integer"/>
				<xs:element name="codiceFiscaleAvvocato" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="OUTPUT_DETTAGLIO_SENTENZA">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="type:DATI_RIEPILOGO_PROCEDIMENTO"/>
				<xs:element ref="type:DATI_SENTENZA"/>
				<xs:element ref="type:ERRORE"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DATI_RIEPILOGO_PROCEDIMENTO">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="annoProcedimentoSIUS" type="xs:integer"/>
				<xs:element name="numeroProcedimentoSIUS" type="xs:integer"/>
				<xs:element name="oggettoProcedimentoSIUS" type="xs:string"/>
				<xs:element name="annoFascicoloSIEP" type="xs:integer"/>
				<xs:element name="numeroFascicoloSIEP" type="xs:integer"/>
				<xs:element name="ufficioFascicoloSIEP" type="xs:string"/>
				<xs:element name="dataFascicoloSIEP" type="type:DATA_TYPE"/>
				<xs:element name="nomeSoggetto" type="xs:string"/>
				<xs:element name="cognomeSoggetto" type="xs:string"/>
				<xs:element name="dataNascita" type="type:DATA_TYPE"/>
				<xs:element name="luogoNascita" type="xs:string"/>
				<xs:element name="codiceProvincia" type="xs:string"/>
				<xs:element name="dataUdienza" type="type:DATA_TYPE"/>
				<xs:element name="nomeMagistratoRelatore" type="xs:string"/>
				<xs:element name="cognomeMagistratoRelatore" type="xs:string"/>
				<xs:element name="etaPresuntaAnni" type="xs:integer" nillable="true"/>
				<xs:element name="etaPresuntaMesi" type="xs:integer" nillable="true"/>
				<xs:element name="sesso" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
