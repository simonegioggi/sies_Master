<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:type="http://it/eng/giustizia/avvocatura/ws/type/elencoProcedimenti" targetNamespace="http://it/eng/giustizia/avvocatura/ws/type/elencoProcedimenti" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="ELENCO_PROCEDIMENTI">
		<xs:annotation>
			<xs:documentation>WS CHE EFFETTUA LA RICERCA PROCEDIMENTI PER
				SOGGETTO
			</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="type:DATI_SOGGETTO_INPUT"/>
				<xs:element ref="type:ELENCO_PROCEDIMENTI_OUTPUT"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DATI_SOGGETTO_INPUT">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="codiceFiscaleAvvocato" type="xs:string"/>
				<xs:element name="codTipoUfficio" type="xs:string">
					<xs:annotation>
						<xs:documentation>UDS: Ufficio di Sorveglianza
							TDS: Tribunale di
							Sorveglianza
							UDSM:Ufficio di Sorveglianza Minori
							TDSM:Tribunale di
							Sorveglianza Minori
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="codDistretto" type="xs:string"/>
				<xs:element name="idSoggetto" type="xs:integer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ELENCO_PROCEDIMENTI_OUTPUT">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="elencoProcedimenti" type="type:DATI_PROCEDIMENTO_TYPE" maxOccurs="unbounded"/>
				<xs:element ref="type:ERRORE"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="DATI_PROCEDIMENTO_TYPE">
		<xs:sequence>
			<xs:element name="idFascicoloSius" type="xs:integer"/>
			<xs:element name="chiaveAnno" type="xs:integer"/>
			<xs:element name="chiaveProgr" type="xs:integer"/>
			<xs:element name="codPosGiuridica" type="xs:string"/>
			<xs:element name="descrPosGiuridica" type="xs:string"/>
			<xs:element name="dataCameraConsiglio" type="type:DATA_TYPE" nillable="true"/>
			<xs:element name="codStatoFascicolo" type="xs:string" nillable="true"/>
			<xs:element name="descrStatoFascicolo" type="xs:string" nillable="true"/>
			<xs:element name="codOggettoProcedimento" type="xs:string" nillable="true"/>
			<xs:element name="descrOggettoProcedimento" type="xs:string" nillable="true"/>
			<xs:element name="dataRichiesta" type="type:DATA_TYPE" nillable="true"/>
			<xs:element name="dataAggiornamento" type="type:DATA_TYPE" nillable="true"/>
			<xs:element name="descrDefinizione" type="xs:string" nillable="true"/>
			<xs:element name="codTipoAtto" type="xs:string"/>
			<xs:element name="descrTipoAtto" type="xs:string" nillable="true"/>
			<xs:element name="codTipoUfficio" type="xs:string">
				<xs:annotation>
					<xs:documentation>UDS: Ufficio di Sorveglianza						TDS: Tribunale diSorveglianza						UDSM:Ufficio di Sorveglianza Minori					TDSM:Tribunale diSorveglianza Minori	</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="ERRORE">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CODICE_ERRORE" type="xs:string"/>
				<xs:element name="DESCR_ERRORE" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="DATA_TYPE">
		<xs:sequence>
			<xs:element name="giorno" type="xs:int"/>
			<xs:element name="mese" type="xs:int"/>
			<xs:element name="anno" type="xs:int"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
