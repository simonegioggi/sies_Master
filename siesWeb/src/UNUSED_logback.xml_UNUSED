<?xml version="1.0" encoding="UTF-8"?>

<!-- For assistance related to logback-translator or configuration  -->
<!-- files in general, please contact the logback user mailing list -->
<!-- at http://www.qos.ch/mailman/listinfo/logback-user             -->
<!--                                                                -->
<!-- For professional support please see                            -->
<!--    http://www.qos.ch/shop/products/professionalSupport         -->
<!--                                                                -->
<configuration>

	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<!-- ######################     LogAvvocatura.log     ######################### -->
	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<appender name="destAvvocatura" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!--See also http://logback.qos.ch/manual/appenders.html#RollingFileAppender-->
		<Append>true</Append>
		<File>${jboss.server.log.dir}/sies/LogAvvocatura.log</File>
		<encoder>
			<pattern>[%d{"dd-MM HH:mm:ss,SSS"}] %-5p [%X{utente}] \(%C{0}.%M:%L\) - %m %n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>DEBUG</level>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<maxIndex>10</maxIndex>
			<FileNamePattern>${jboss.server.log.dir}/sies/LogAvvocatura.log.%i</FileNamePattern>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<MaxFileSize>5000KB</MaxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<!-- ######################         Debug.log         ######################### -->
	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<appender name="destDebug" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!--See also http://logback.qos.ch/manual/appenders.html#RollingFileAppender-->
		<Append>true</Append>
		<File>${jboss.server.log.dir}/sies/Debug.log</File>
		<encoder>
			<pattern>[%d{"dd-MM HH:mm:ss,SSS"}] %-5p [%X{utente}] \(%C{0}.%M:%L\) - %m %n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>DEBUG</level>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<maxIndex>10</maxIndex>
			<FileNamePattern>${jboss.server.log.dir}/sies/Debug.log.%i</FileNamePattern>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<MaxFileSize>5000KB</MaxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<!-- ###################        logErrorSiep.html        ###################### -->
	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<appender name="destError" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!--See also http://logback.qos.ch/manual/appenders.html#RollingFileAppender-->
		<File>${jboss.server.log.dir}/sies/logErrorSiep.html</File>
		<Append>true</Append>
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="ch.qos.logback.classic.html.HTMLLayout">
				<!--See http://logback.qos.ch/manual/layouts.html#ClassicHTMLLayout-->
				<!--for documentation-->
				<!-- LocationInfo>true</LocationInfo>-->
				<Title>Log Siap</Title>
				<Pattern>%relative%thread%mdc%level%logger%msg</Pattern>
				<!-- cssBuilder class="ch.qos.logback.classic.html.UrlCssBuilder">
	      	<url>${jboss.server.log.dir}/../configuration/logErrorSiep.css</url>
	      </cssBuilder-->
			</layout>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>ERROR</level>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<maxIndex>20</maxIndex>
			<FileNamePattern>${jboss.server.log.dir}/sies/logErrorSiep.html.%i</FileNamePattern>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<MaxFileSize>1000KB</MaxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<!-- ####################         LogStampa.log         ####################### -->
	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<appender name="destStampa" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!--See also http://logback.qos.ch/manual/appenders.html#RollingFileAppender-->
		<File>${jboss.server.log.dir}/sies/LogStampa.log</File>
		<Append>true</Append>
		<encoder>
			<pattern>[%d{"dd-MM HH:mm:ss,SSS"}] %-5p [%X{utente}] \(%C{0}.%M:%L\) - %m %n</pattern>
		</encoder>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>DEBUG</level>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<maxIndex>10</maxIndex>
			<FileNamePattern>${jboss.server.log.dir}/sies/LogStampa.log.%i</FileNamePattern>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<MaxFileSize>5000KB</MaxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<!-- #################         WindWardReports.log         #################### -->
	<!-- ########################################################################## -->
	<!-- ########################################################################## -->
	<appender name="R" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!--See http://logback.qos.ch/manual/appenders.html#RollingFileAppender-->
		<!--and http://logback.qos.ch/manual/appenders.html#TimeBasedRollingPolicy-->
		<!--for further documentation-->
		<File>${jboss.server.log.dir}/sies/WindWardReports.log</File>
		<encoder>
			<pattern>%5p (%F:%L) - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${jboss.server.log.dir}/sies/WindWardReports.log.%d{yyyy-MM-dd}</fileNamePattern>
		</rollingPolicy>
	</appender>

	<appender name="Async-Appender" class="ch.qos.logback.classic.AsyncAppender">
		<appender-ref ref="destDebug"/>
		<appender-ref ref="destError"/>
	</appender>

	<logger name="AvvocaturaLog" additivity="false" level="ALL">
		<appender-ref ref="destAvvocatura"/>
	</logger>
	<logger name="SIESLog" additivity="false" level="ALL">
		<appender-ref ref="Async-Appender"/>
	</logger>
	<logger name="StampaLog" additivity="false" level="ALL">
		<appender-ref ref="destStampa"/>
	</logger>
	<root level="OFF">
		<appender-ref ref="R"/>
	</root>

</configuration>